PORT=3003
# Период батча quotes:batch, мс (контракт драйвера сайта ~250)
BATCH_MS=250
BINANCE_WS_URL=wss://stream.binance.com:9443
# Twelve Data (форекс/металлы/акции/индексы). Пусто — вселенная только Binance.
# Бюджет = тариф ключа: free 8/мин и 800/день; PRO — поднять, поллер ускорится сам
TWELVEDATA_API_KEY=
TWELVEDATA_CREDITS_PER_MIN=8
TWELVEDATA_CREDITS_PER_DAY=800

# --- Реестр провайдеров (Р-047, ADR-031) ---
# Файл реестра: какие источники известны, какой включён, кто что ведёт.
# Файла нет -> встроенное умолчание, и оно называет себя умолчанием.
# Файл есть и не читается -> источники НЕ запускаются (fail-closed).
# В контуре путь обязан лежать на томе: иначе переключатель в админке
# работает до первого деплоя.
MDS_REGISTRY_PATH=./data/providers.json

# Секрет служебной ручки /v1/admin/providers. Умолчания НЕТ и быть не может:
# умолчание здесь - это открытая ручка смены источника цены.
# Не задан -> ручка выключена целиком (503), реестр меняется только правкой
# файла. Требования: ASCII без пробелов, не короче 24 символов.
MDS_ADMIN_TOKEN=

# Ключ источника по его id из реестра. Пример для id "twelvedata":
# MDS_PROVIDER_KEY_TWELVEDATA=
#
# ВНИМАНИЕ (MDS-13, поправка 25.10). Здесь было написано, что общий вид
# "делает добавление второго источника того же адаптера правкой данных плюс
# одной переменной, а не правкой кода". ЭТО НЕПРАВДА. Реестр ко второму
# источнику готов, каталог - нет: поле provider в строке каталога стоит
# литералом, и запись реестра с новым id не упоминается в каталоге никем -
# источник запустится и получит пустой список инструментов.
# Проверено опытом: +binance-2 только в реестр -> 0 символов с двумя
# кандидатами. Второй источник сегодня = правка кода.

# Период пересчёта маршрутизации: через него замечается тишина источника
# и происходит failover на запасного.
MDS_ROUTING_RECHECK_MS=5000

# Разрешить правку реестра, меняющую ЛИЧНОСТЬ ведущего источника у живого
# символа (Р-318). Умолчание - ЗАПРЕЩЕНО, и это не осторожность:
# переключатель, открытый по умолчанию, есть отсутствующий запрет с
# видимостью запрета.
# Смена источника на живом символе - разрыв ряда; потребитель показывает её
# очередным тиком, то есть скачком цены как движением рынка. Снимать, когда
# витрина научится показывать разрыв. Принимается ровно "true".
# MDS_ALLOW_ROUTING_IDENTITY_CHANGE=true

# Порог свежести котировки. Умолчания нет сознательно (КОНТРАКТЫ.md 5г):
# не задан -> котировки не отдаются вовсе, /health 503.
QUOTE_STALE_AFTER_MS=60000

# --- Инструменты платформы из CMS (договор «инструменты-платформы», 21.11) ---
# MDS подписывается у поставщика только на инструменты, выбранные в CMS
# («Инструменты платформы»), а не на весь каталог.
# Опрос: GET {CMS_API_URL}/cms/platform/instruments с заголовком X-API-Key,
# применяется только при росте version. Пусто -> CMS не опрашивается.
CMS_API_URL=
CMS_API_KEY=
# Период опроса, мс (по умолчанию 30000).
CMS_POLL_MS=30000
# Секрет вебхука POST /v1/hooks/platform-instruments: подпись
# X-Signature: sha256=<hex HMAC-SHA256 тела> - как вебхуки CMS -> сайт.
# Пусто -> вебхук выключен (503), остаётся опрос.
CMS_WEBHOOK_SECRET=
# Последний удачный список (атомарная запись). По умолчанию рядом с
# MDS_REGISTRY_PATH: ./data/platform-instruments.json. В контуре - на томе.
# Порядок на старте: CMS -> этот файл -> весь каталог с предупреждением.
# MDS_PLATFORM_INSTRUMENTS_PATH=./data/platform-instruments.json

# --- Модуль рыночных данных, API v2 (адаптер modulev2) ---
# База v2 вместе с ключом в пути: https://<хост>/<ключ>. Адрес и есть секрет:
# в репозиторий и логи не класть (в логах MDS путь маскируется).
# Пусто -> у источника modulev2 нет каталога: форекс, металлы, акции и
# энергоносители модуля не идут, в /health предупреждение.
# Каталог: GET <база>/v2/instruments при старте и раз в сутки.
MARKET_V2_API_URL=
# Поток: по умолчанию выводится из MARKET_V2_API_URL (http->ws, + /v2/stream).
# MARKET_V2_WS_URL=
# Тишина потока (нет quote/status/ping), после которой соединение рвётся и
# переподключается, мс (по умолчанию 45000; ping модуля - раз в 15 с).
# MARKET_V2_SILENCE_MS=45000
# Период обновления каталога v2 и повтор после неудачи, мс.
# MARKET_V2_CATALOG_REFRESH_MS=86400000
# MARKET_V2_CATALOG_RETRY_MS=300000
# Период обновления закрытия предыдущего дня (для changePercent), мс.
# MARKET_V2_CHANGE_REFRESH_MS=3600000
# Период опроса <база>/v2/health для /health MDS, мс.
# MARKET_V2_HEALTH_POLL_MS=60000
